import fs from "node:fs";

import {parseTradeLedger} from "../../lib/trade-ledger/parser/tradeLedgerParser";

const text=fs.readFileSync("contract-note.txt","utf8");

const contracts=parseTradeLedger(text);

console.log("Contract Notes:",contracts.length);

const first=contracts[0];

if(first){

  console.log("Trades:",first.trades.length);

  console.table(first.trades.slice(0,10));

}
